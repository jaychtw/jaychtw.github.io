{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"],
    "skipLibCheck": true
  },
  "include": ["scripts/**/*.ts", "src/**/*.ts", "tests/**/*.ts"],
  "exclude": ["tests/archive"]
}
